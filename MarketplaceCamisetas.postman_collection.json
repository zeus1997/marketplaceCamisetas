            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Martin\",\n  \"apellido\": \"Arias\",\n  \"email\": \"admin.marketplace@uade.edu.ar\",\n  \"password\": \"Admin123\",\n  \"direccion\": \"Av. Cabildo 2150, CABA\",\n  \"telefono\": \"+54 11 5555-0101\"\n}"
