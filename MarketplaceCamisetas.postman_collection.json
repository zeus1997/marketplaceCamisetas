            "body": {
              "mode": "raw",
              "raw": "{\n  \"talleId\": {{talleId_m}},\n  \"stock\": 25,\n  \"sku\": \"ARG-2026-TIT-M-AZN\",\n  \"color\": \"Azul noche\"\n}"
            },
            "url": "{{baseUrl}}/api/camisetas/{{camisetaId_argentina}}/variantes"
