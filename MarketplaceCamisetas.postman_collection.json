    {
      "name": "3. Camisetas y Variantes",
      "item": [
        {
          "name": "Crear Camiseta - Argentina Titular 2026 (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Camiseta Argentina Titular 2026\",\n  \"descripcion\": \"Modelo titular celeste y blanco con detalles dorados.\",\n  \"precio\": 129999.90,\n  \"imagen\": \"https://img.ejemplo.com/argentina-2026-titular.jpg\",\n  \"tipoCamisetaId\": {{tipoId_titular}},\n  \"generoId\": {{generoId_hombre}},\n  \"paisId\": {{paisId_argentina}}\n}"
            },
            "url": "{{baseUrl}}/api/camisetas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
