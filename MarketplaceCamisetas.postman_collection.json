    {
      "name": "4. Carrito y Pedidos (USER)",
      "item": [
        {
          "name": "Ver Mi Carrito",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_user}}" }
            ],
            "url": "{{baseUrl}}/api/carrito"
          }
        },
        {
          "name": "Agregar Item al Carrito",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_user}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"varianteId\": {{varianteId_argentina_m}},\n  \"cantidad\": 2\n}"
            },
            "url": "{{baseUrl}}/api/carrito/items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.items && json.items.length > 0) {",
                  "    pm.environment.set('carritoItemId', json.items[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar Cantidad del Item",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_user}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": 1\n}"
            },
            "url": "{{baseUrl}}/api/carrito/items/{{carritoItemId}}"
          }
        },
        {
          "name": "Checkout - Crear Pedido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_user}}" }
            ],
            "url": "{{baseUrl}}/api/pedidos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('pedidoId', json.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar Mis Pedidos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_user}}" }
            ],
            "url": "{{baseUrl}}/api/pedidos"
          }
        },
        {
          "name": "Cancelar Mi Pedido",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_user}}" }
            ],
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}/cancelar"
          }
        }
      ]
    },
